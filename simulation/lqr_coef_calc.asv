clear
close all
%% lqr cofficient calculate
filename = fileparts(mfilename("fullpath"));

% load A and B matrix
load(fullfile(filename,"ABmat.mat"));
% read the data of barycenter
T = readtable(fullfile(filename,'barycenter_data.xlsx'));
L_data = T.Var1/1000;
L_pb_data = -T.Var3/1000;
L_wp_data = T.Var5/1000;
i = height(T);

% use L to calculate L_pb and L_wp
syms L_sym 
p = polyfit(L_data,L_pb_data,3);
L_pb_func = p(1)*L_sym^3 + p(2)*L_sym^2 + p(3)*L_sym + p(4);
p = polyfit(L_data,L_wp_data,3);
L_wp_func = p(1)*L_sym^3 + p(2)*L_sym^2 + p(3)*L_sym + p(4);

% set balance point
syms beta d_beta gamma d_gamma d_x
beta = 0;
d_beta = 0;
gamma = 0;
d_gamma = 0;
d_x = 0;

% set physical parameters
syms m_b m_p m_w
syms R_w L_c
syms I_w I_p I_b
syms g L
m_b = 5.8;
m_p = 1.524;
m_w = 0.565;

R_w = 0.06;
L_c = 0.01;

I_w = m_w*R_w^2/2;
I_p_sym = m_p*L_sym^2/12;
I_b = m_b*((538/1000)^2+(225/1000)^2)/12;
g = 9.81;

for step = 1:i
    L = L_data(step);
    L_pb = double(subs(L_pb_func, L_sym, L));
    L_wp = double(subs(L_wp_func, L_sym, L));
    I_p = double(subs(I_p_sym, L_sym, L));
    A = double(subs(A_sym));
    B = double(subs(B_sym));
    disp([L,L_pb,L_wp])
end
