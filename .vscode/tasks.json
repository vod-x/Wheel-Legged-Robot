{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello"
        },
        {
            "label": "Cmake Configure 1",
            "type": "shell",
            "command": "cmake",
            "args": [
                // "-O0",
                // "-g3",
                "-GNinja",
                "-S./embedded_system",
                "-B./embedded_system/Build",
                "-DCMAKE_C_FLAGS_DEBUG:STRING=-Og -g3",
                "-DCMAKE_CXX_FLAGS_DEBUG:STRING=-Og -g3",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-UPRINTF_FLOAT=ON",
                "-DROBOT_ID=3",
                "-DDEBUG_MODE=1",
                "-DDEMO_MODE=0",
                // "-DIMU_CALIBRATION_EN=0",
            ],
            "group": "build"
        },
        {
            "label": "Cmake Configure 2",
            "type": "shell",
            "command": "cmake",
            "args": [
                // "-O0",
                // "-g3",
                "-GNinja",
                "-S./embedded_system",
                "-B./embedded_system/Build",
                "-DCMAKE_C_FLAGS_DEBUG:STRING=-Og -g3",
                "-DCMAKE_CXX_FLAGS_DEBUG:STRING=-Og -g3",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-UPRINTF_FLOAT=ON",
                "-DROBOT_ID=4",
                "-DDEBUG_MODE=1",
                "-DDEMO_MODE=0",
                // "-DIMU_CALIBRATION_EN=0",
            ],
            "group": "build"
        },
        {
            "label": "Cmake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./embedded_system/Build",
                "--target",
                "all"
            ],
            "group": "build"
        },
  
        {
            "label": "J-Link Flash",
            "type": "shell",
            "command": "JLink.exe",
            "args": [
                "-NoGui",
                "1",
                "-CommandFile",
                // "/.vscode/flash.jlink"
                "D:/Project/wheel_legged_robot/flash.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]

    
}