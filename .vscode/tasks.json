{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello"
        },
        {
            "label": "Cmake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-GNinja",
                "-S./embedded_system",
                "-B./embedded_system/Build",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-UPRINTF_FLOAT=ON"
            ],
            "group": "build"
        },
        {
            "label": "Cmake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./embedded_system/Build",
                "--target",
                "all"
            ],
            "group": "build"
        },
  
    ]
    
}